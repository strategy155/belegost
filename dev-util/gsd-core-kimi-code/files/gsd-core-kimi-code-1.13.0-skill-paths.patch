 /**
+ * Kimi Code agent converter — tool-vocabulary gap (follow-up to the #2454
+ * kimi-code capability descriptor).
+ *
+ * Kimi Code's built-in web tools are WebSearch and FetchURL; it has no
+ * WebFetch tool, so a Claude-shaped `tools:` allowlist entry of WebFetch
+ * silently matches nothing and the agent loses its URL-fetch grant. Rename
+ * the token to FetchURL inside YAML frontmatter `tools:`/`allowed-tools:`
+ * lines only — both the inline comma-list form (`tools: A, B`) and the
+ * block-list form (`tools:` + `- A` items), mirroring
+ * convertClaudeAgentToZcodeAgent's frontmatter scan. Body prose mentions of
+ * WebFetch are left verbatim: they are guidance text, not grants, and the
+ * model resolves tool names against the runtime's real tool list.
+ *
+ * Byte-identical for an agent with no WebFetch grant and for an agent with
+ * no (or unterminated) frontmatter. Resolved by name from capabilities/
+ * kimi-code/capability.json's agents-kind `converter` field via
+ * convertedAgentsKind's conversionExports[converterName] dispatch.
+ */
+function convertClaudeAgentToKimiCodeAgent(content) {
+    if (!content.includes('WebFetch'))
+        return content;
+    const lines = content.split('\n');
+    if (lines[0] !== '---')
+        return content;
+    let fmEnd = -1;
+    for (let i = 1; i < lines.length; i++) {
+        if (lines[i] === '---') {
+            fmEnd = i;
+            break;
+        }
+    }
+    if (fmEnd === -1)
+        return content; // unterminated frontmatter — leave verbatim
+    let changed = false;
+    let inToolsBlock = false;
+    for (let i = 1; i < fmEnd; i++) {
+        const line = lines[i];
+        if (/^(?:tools|allowed-tools):[ \t]*\S/.test(line)) {
+            inToolsBlock = false;
+            if (line.includes('WebFetch')) {
+                lines[i] = line.replace(/\bWebFetch\b/g, 'FetchURL');
+                changed = true;
+            }
+            continue;
+        }
+        if (/^(?:tools|allowed-tools):[ \t]*$/.test(line)) {
+            inToolsBlock = true;
+            continue;
+        }
+        if (inToolsBlock && /^[ \t]*-[ \t]*\S/.test(line)) {
+            if (line.includes('WebFetch')) {
+                lines[i] = line.replace(/\bWebFetch\b/g, 'FetchURL');
+                changed = true;
+            }
+            continue;
+        }
+        inToolsBlock = false;
+    }
+    return changed ? lines.join('\n') : content;
+}
