+# belegost: system-library link set (Gentoo unbundling).  These land in
+# OSSEC_LIBS, which the $(WAZUHEXT_LIB) rule appends to every link of
+# libwazuhext.so; the daemons link libwazuhext.so and inherit the
+# DT_NEEDED entries transitively.
+EXTERNAL_LIBS := $(PROCPS_LIB)
+OSSEC_LIBS += -lz -lpcre2-8 -lssl -lcrypto -lsqlite3 -lyaml -lcurl -lmsgpackc -lcjson -ldbus-1 -lrpm
+ifneq (,$(filter ${USE_AUDIT},YES yes y Y 1))
+OSSEC_LIBS += -laudit
+endif
+
 .PHONY: external test_external
 external: test_external $(EXTERNAL_LIBS) $(JEMALLOC_LIB)
 
