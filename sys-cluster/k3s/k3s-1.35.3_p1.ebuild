EAPI=8

DESCRIPTION="Lightweight Kubernetes distribution for IoT and edge computing"
HOMEPAGE="
	https://k3s.io
	https://github.com/k3s-io/k3s
"

MY_K3S_REV="${PV##*_p}"
MY_BASE_PV="${PV%%_p*}"
MY_TAG="v${MY_BASE_PV}%2Bk3s${MY_K3S_REV}"

SRC_URI="
	amd64? (
		https://github.com/k3s-io/k3s/releases/download/${MY_TAG}/k3s
			-> k3s-amd64-${PV}
	)
	arm64? (
		https://github.com/k3s-io/k3s/releases/download/${MY_TAG}/k3s-arm64
			-> k3s-arm64-${PV}
	)
	https://raw.githubusercontent.com/k3s-io/k3s/${MY_TAG}/install.sh
		-> k3s-install-${PV}.sh
"
S="${WORKDIR}"

LICENSE="Apache-2.0"
SLOT="0"
KEYWORDS="~amd64 ~arm64"
RESTRICT="strip"
QA_PREBUILT="opt/bin/k3s"

RDEPEND="
	net-firewall/iptables
"

src_compile() {
	:
}

src_install() {
	local my_bin="k3s-amd64-${PV}"
	use arm64 && my_bin="k3s-arm64-${PV}"

	exeinto /opt/bin
	newexe "${DISTDIR}/${my_bin}" k3s

	# Ship upstream install.sh for service generation in pkg_postinst,
	# mirroring the official RPM spec approach:
	# https://github.com/k3s-io/k3s/blob/main/package/rpm/k3s.spec
	insinto /usr/share/k3s/setup
	newins "${DISTDIR}/k3s-install-${PV}.sh" install.sh

	keepdir /etc/rancher/k3s
	keepdir /var/lib/rancher/k3s
}

pkg_postinst() {
	# Run upstream install.sh to generate service files, killall and
	# uninstall scripts — identical to the official RPM %post block.
	export INSTALL_K3S_UPGRADE=true
	export INSTALL_K3S_BIN_DIR=/opt/bin
	export INSTALL_K3S_SKIP_DOWNLOAD=true
	export INSTALL_K3S_SKIP_ENABLE=true
	export INSTALL_K3S_SKIP_START=true

	(
		# Server service
		INSTALL_K3S_NAME=server \
			sh "${EROOT}"/usr/share/k3s/setup/install.sh

		# Agent service
		INSTALL_K3S_SYMLINK=skip \
		INSTALL_K3S_BIN_DIR_READ_ONLY=true \
		K3S_TOKEN=placeholder \
		K3S_URL=https://placeholder:6443 \
			sh "${EROOT}"/usr/share/k3s/setup/install.sh agent

	) >"${EROOT}"/usr/share/k3s/setup/install.log 2>&1

	elog "Two services installed: k3s-server and k3s-agent."
	elog ""
	elog "For a server (control plane + agent):"
	elog "  rc-update add k3s-server default"
	elog "  rc-service k3s-server start"
	elog ""
	elog "For an agent (worker node), first configure"
	elog "  /etc/rancher/k3s/k3s-agent.env  (K3S_URL and K3S_TOKEN)"
	elog "then:"
	elog "  rc-update add k3s-agent default"
	elog "  rc-service k3s-agent start"
	elog ""
	elog "Configuration: /etc/rancher/k3s/config.yaml"
	elog "Install log:   /usr/share/k3s/setup/install.log"
}

pkg_postrm() {
	# Clean up files generated by install.sh (not tracked by Portage).
	local f
	for f in \
		"${EROOT}"/opt/bin/k3s-server-uninstall.sh \
		"${EROOT}"/opt/bin/k3s-agent-uninstall.sh \
		"${EROOT}"/opt/bin/k3s-killall.sh \
	; do
		if [ -x "${f}" ]; then
			einfo "Running ${f##*/}"
			"${f}" 2>/dev/null || true
		fi
	done
}
